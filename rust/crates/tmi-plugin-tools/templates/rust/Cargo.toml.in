# {{id}}: a tmiki format plugin on tmi-plugin-sdk. `tmiki plugin build` runs
# `cargo build --release --target wasm32-wasip2` (the component) and
# `cargo build --features dev` (the same code as a development plugin,
# target/debug/{{id}}-dev).
[package]
name = "tmi-plugin-{{id}}"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
crate-type = ["cdylib", "rlib"]

[features]
# the development plugin (src/bin/dev.rs)
dev = []

[[bin]]
name = "{{id}}-dev"
path = "src/bin/dev.rs"
required-features = ["dev"]

[dependencies]
# sdk/: the copy of tmi-plugin-sdk (and the wire it speaks, tmi-plugin-dev)
# that `tmiki plugin new` wrote for this tmiki; it pins wit-bindgen, whose
# version decides the code written for wit/
tmi-plugin-sdk = { path = "sdk/tmi-plugin-sdk" }

# Its own workspace, also when it sits inside another one.
[workspace]

[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
panic = "abort"
debug = false
strip = "debuginfo"